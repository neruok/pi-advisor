{
  "name": "@neruok/pi-advisor",
  "version": "0.1.1",
  "license": "MIT",
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "type": "module",
  "description": "Isolated, multi-turn advice for Pi agents",
  "keywords": ["pi-package", "pi-extension", "advisor", "coding-agent"],
  "repository": { "type": "git", "url": "git+https://github.com/neruok/pi-advisor.git" },
  "homepage": "https://github.com/neruok/pi-advisor#readme",
  "bugs": { "url": "https://github.com/neruok/pi-advisor/issues" },
  "pi": { "extensions": ["./advisor.ts"] },
  "files": ["advisor.ts", "lib/*.ts", "README.md", "docs/pi-advisor.md"],
  "engines": { "node": ">=24" },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": { "optional": true },
    "@earendil-works/pi-ai": { "optional": true },
    "@earendil-works/pi-tui": { "optional": true },
    "typebox": { "optional": true }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.4",
    "@earendil-works/pi-ai": "1.0.4",
    "@earendil-works/pi-tui": "1.0.4",
    "typebox": "1.3.27",
    "typescript": "5.9.3",
    "@types/node": "26.6.4"
  },
  "scripts": {
    "check": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run check",
    "packcheck": "node scripts/check-package.mjs",
    "prepublishOnly": "npm run verify && npm run packcheck"
  }
}
